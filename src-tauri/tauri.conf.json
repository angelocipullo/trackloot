{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrackLoot",
  "version": "1.0.0",
  "identifier": "it.angelocipullo.trackloot",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TrackLoot",
        "width": 640,
        "height": 720,
        "minWidth": 420,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Download SoundCloud & Spotify tracks as tagged mp3s",
    "copyright": "\u00a9 2026 GANGE",
    "publisher": "GANGE",
    "homepage": "https://www.gange.wtf",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
